{
  "name": "scratch-storage",
  "version": "9.9.9",
  "description": "Load and store project and asset files for Scratch 3.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "homepage": "https://github.com/scratchfoundation/scratch-storage#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/scratchfoundation/scratch-storage.git",
    "sha": "83683f12783c3aa548eab39928f0424dad3fdcd5"
  },
  "main": "./dist/node/scratch-storage.js",
  "module": "./dist/web/scratch-storage.mjs",
  "browser": "./dist/web/scratch-storage.min.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/web/scratch-storage.mjs",
      "require": "./dist/node/scratch-storage.js",
      "browser": "./dist/web/scratch-storage.min.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "commitmsg": "commitlint -e $GIT_PARAMS",
    "coverage": "tap ./test/{unit,integration}/*.js --coverage --coverage-report=lcov",
    "dev": "vite",
    "prepublishOnly": "npm run build",
    "semantic-release": "semantic-release",
    "test": "npm run test:lint && vitest run",
    "test:clearCache": "vitest --clearCache",
    "test:integration": "vitest run test/integration",
    "test:lint": "eslint .",
    "test:unit": "vitest run test/unit",
    "version": "json -f package.json -I -e \"this.repository.sha = '$(git log -n1 --pretty=format:%H)'\"",
    "watch": "vite build --watch"
  },
  "tap": {
    "check-coverage": false
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "js-md5": "^0.7.3",
    "minilog": "^3.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "18.6.1",
    "@commitlint/config-conventional": "18.6.3",
    "@commitlint/travis-cli": "8.3.6",
    "@types/js-md5": "^0.7.0",
    "@types/node": "^20.0.0",
    "eslint": "8.57.0",
    "eslint-config-scratch": "9.0.8",
    "eslint-plugin-react": "7.34.4",
    "husky": "8.0.3",
    "json": "^9.0.4",
    "scratch-semantic-release-config": "1.0.14",
    "semantic-release": "19.0.5",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.9.0",
    "vitest": "^1.0.0"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
